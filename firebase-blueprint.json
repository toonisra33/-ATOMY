{
  "entities": {
    "Lead": {
      "title": "Lead",
      "description": "A prospect registration or contact request for Atomy business mentorship.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Full name of the prospect",
          "maxLength": 100
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number",
          "maxLength": 20
        },
        "lineId": {
          "type": "string",
          "description": "LINE ID of the prospect",
          "maxLength": 50
        },
        "sponsorId": {
          "type": "string",
          "description": "Sponsor ID the lead is inquiring under",
          "maxLength": 50
        },
        "status": {
          "type": "string",
          "enum": ["new", "contacted", "registered", "rejected"],
          "description": "Current status of the lead"
        },
        "createdAt": {
          "type": "timestamp",
          "description": "Firestore server timestamp when the lead was submitted"
        }
      },
      "required": ["name", "phone", "sponsorId", "createdAt", "status"]
    },
    "SponsorProfile": {
      "title": "SponsorProfile",
      "description": "Saved sponsor profile and affiliate link settings.",
      "type": "object",
      "properties": {
        "sponsorId": {
          "type": "string",
          "description": "Unique Atomy member/sponsor ID",
          "maxLength": 50
        },
        "sponsorName": {
          "type": "string",
          "description": "Sponsor display name",
          "maxLength": 100
        },
        "ownerUid": {
          "type": "string",
          "description": "Firebase Auth UID of the owner to ensure strict ABAC zero-trust security",
          "maxLength": 128
        },
        "pinHash": {
          "type": "string",
          "description": "Legacy 6-digit PIN",
          "maxLength": 10
        },
        "sponsorPosition": {
          "type": "string",
          "description": "Sponsor rank or position title",
          "maxLength": 50
        },
        "lineId": {
          "type": "string",
          "description": "Sponsor LINE ID",
          "maxLength": 50
        },
        "lineUrl": {
          "type": "string",
          "description": "Sponsor LINE Official or personal add link",
          "maxLength": 200
        },
        "phoneNumber": {
          "type": "string",
          "description": "Sponsor phone number",
          "maxLength": 20
        },
        "teamName": {
          "type": "string",
          "description": "Team name",
          "maxLength": 100
        },
        "avatarUrl": {
          "type": "string",
          "description": "Avatar image URL"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["sponsorId", "sponsorName", "ownerUid", "lineId", "updatedAt"]
    },
    "GalleryItem": {
      "title": "GalleryItem",
      "description": "Gallery images displayed in the interactive album carousel.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "enum": ["products", "seminar", "company", "global"] },
        "badge": { "type": "string", "maxLength": 80 },
        "badgeColor": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 1000 },
        "highlightPoints": { "type": "array", "items": { "type": "string" } },
        "imageUrl": { "type": "string" },
        "caption": { "type": "string", "maxLength": 300 },
        "order": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "category", "badge", "badgeColor", "description", "highlightPoints", "imageUrl"]
    }
  },
  "firestore": {
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Collection of prospect leads and registration inquiries"
    },
    "/sponsors/{sponsorId}": {
      "schema": "SponsorProfile",
      "description": "Collection of sponsor landing profiles"
    },
    "/gallery/{itemId}": {
      "schema": "GalleryItem",
      "description": "Collection of interactive album showcase items"
    }
  }
}
