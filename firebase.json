{
  "firestore": {
    "database": "ai-studio-atomysatellitefu-2e7af57f-c75f-4374-9cd1-f638571d9f9d",
    "rules": "firestore.rules"
  },
  "hosting": {
    "target": "atomy",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  }
}