rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true || 
        request.auth.token.role == 'admin'
      );
    }
    
    // Helper to check if user owns the document
    function isOwner(ownerUid) {
      return request.auth != null && request.auth.uid == ownerUid;
    }

    match /sponsors/{sponsorId} {
      allow read: if true; // Anyone can read sponsor profiles to see the landing page
      // Allow creation/update if admin, or if the user is claiming their own profile
      allow write: if isAdmin() || isOwner(request.resource.data.ownerUid) || isOwner(resource.data.ownerUid);
    }

    match /leads/{leadId} {
      // Admins can read all leads. Sponsors can only read their own leads.
      allow read: if isAdmin() || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      // Anyone (even unauthenticated) can submit a new lead.
      allow create: if true;
      // Only admins or the sponsor who owns the lead can update it (e.g. changing status)
      allow update: if isAdmin() || isOwner(resource.data.ownerUid);
      // Only admins can delete leads
      allow delete: if isAdmin();
    }
  }
}
