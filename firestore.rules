rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isValidLead(data) {
      return data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 100
        && data.phoneNumber is string && data.phoneNumber.size() >= 8 && data.phoneNumber.size() <= 20
        && data.sponsorId is string && data.sponsorId.size() > 0 && data.sponsorId.size() <= 50
        && data.createdAt is string
        && data.status in ['new', 'contacted', 'completed']
        && (data.hasConsent == true); // enforce PDPA consent
    }

    match /leads/{leadId} {
      allow create: if isValidLead(request.resource.data);
      allow read, update: if true; // In production without Firebase Auth, read/update relies on frontend UI gate
      allow delete: if false;
    }

    match /sponsors/{sponsorId} {
      allow read: if true;
      allow write: if request.resource.data.sponsorId == sponsorId 
        && request.resource.data.keys().hasAll(['sponsorId', 'sponsorName']);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
