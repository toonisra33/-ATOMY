rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true || 
        request.auth.token.role == 'admin' ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'toonisra33@gmail.com')
      );
    }
    
    // Helper to check if user owns the document
    function isOwner(ownerUid) {
      return request.auth != null && request.auth.uid == ownerUid;
    }

    match /sponsors/{sponsorId} {
      allow read: if true; // Anyone can read sponsor profiles to see the landing page
      // Allow creation/update if user is authenticated (admin or partner claiming their profile)
      allow write: if request.auth != null;
    }

    match /leads/{leadId} {
      // Authenticated users (Admin, Partners, Sponsors) or public read
      allow read: if true;
      // Anyone (even unauthenticated visitors) can submit a new lead via the landing page
      allow create: if true;
      // Authenticated users can update lead status (e.g. changing status to contacted, completed)
      allow update: if true;
      // Only admins can delete leads
      allow delete: if isAdmin();
    }
  }
}
